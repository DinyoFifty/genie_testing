# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: bt_cs_soc_reflector_studio
label: bt_cs_soc_reflector_studio
description: Channel Sounding (CS) Reflector for Bluetooth LE. This example sends
  measurement results back to the CS Initiator device via the CS Ranging Service.
  The CS Reflector has to connect to at least one CS Initiator device to start the
  measurement. It can connect to a maximum of four CS Initiators at a time. The application
  starts advertising after boot and keeps advertising until every connection slots
  are occupied. If a connection slot becomes free, the device will start advertising
  again.
category: Bluetooth Examples
filter:
- name: Device Type
  value:
  - SoC
- name: Project Difficulty
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Bluetooth
package: bluetooth_le_app
quality: production
readme:
- path: readme.md
source:
- path: app.c
- path: security.c
tag:
- hwfilter:device:device_generic_family_efr32xg24
- prebuilt_demo
- hwfilter:device:device_supports_bluetooth
- toolchain:llvm
- hwfilter:!device:device_wlcsp
- toolchain:gcc
- hwfilter:board:hardware_board_supports_cs
include:
- path: .
  file_list:
  - path: app.h
  - path: security.h
sdk:
  vendor: silabs
  id: simplicity_sdk
  version: 2026.6.2
