{
  "clangd.arguments": [
    "--query-driver=arm-none-eabi-gcc"
  ],
  "files.exclude": {
    "**/__pycache__": true,
    ".venv": true,
    ".vscode": true,
    ".codex": true,
    ".gitignore": true,
    "*.code-workspace": true
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "extensions.experimental.affinity": {
    "local-genie.genie-files-manager": 1
  }
}
